# Auth service (server-side only)
AUTH_JWKS_URL=http://localhost:3001/auth/.well-known/jwks.json
AUTH_ISSUER=https://local.math-on-canvas.dev
AUTH_AUDIENCE=math-on-canvas-local
AUTH_API_URL=http://localhost:3001

# Auth URL exposed to the client
NEXT_PUBLIC_AUTH_API_URL=http://localhost:3001

# Documents service (server-side only) — powers the catalog
DOCUMENTS_API_URL=http://localhost:3002

# Thumbnails CDN (CloudFront) — serves document thumbnails to the browser:
#   https://<distribution>.cloudfront.net/thumbnails/{documentId}.png
# The documents S3 bucket blocks direct access and there is no API thumbnail
# endpoint, so this is required for catalog thumbnails to load. Public host;
# get the value via `terraform output cloudfront_domain_name`.
NEXT_PUBLIC_DOCUMENTS_CDN_BASE_URL=https://example.cloudfront.net

# Editor SPA URL (proxied to /editor)
# EDITOR_URL=http://localhost:5173

# Docs site URL (proxied to /docs)
# DOCS_URL=http://localhost:4321

# Google Analytics 4
# Get your Measurement ID from Google Analytics → Admin → Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX